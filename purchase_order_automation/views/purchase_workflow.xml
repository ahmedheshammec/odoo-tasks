<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_workflow_form_view" model="ir.ui.view">
            <field name="name">purchase.workflow.form.view</field>
            <field name="model">purchase.workflow</field>
            <field name="arch" type="xml">
                <form string="Purchase Workflow">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="is_default"/>
                                <field name="is_create_invoice"/>
                            </group>
                            <group>
                                <field name="is_post_invoice"/>
                                <field name="is_validate_stock"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="purchase_workflow_tree_view" model="ir.ui.view">
            <field name="name">purchase.workflow.tree.view</field>
            <field name="model">purchase.workflow</field>
            <field name="arch" type="xml">
                <tree string="Purchase Workflow">
                    <field name="name"/>
                    <field name="is_default"/>
                    <field name="is_create_invoice"/>
                    <field name="is_post_invoice"/>
                    <field name="is_validate_stock"/>
                </tree>
            </field>
        </record>

        <record id="purchase_workflow_action_view" model="ir.actions.act_window">
            <field name="name">Purchase Workflow</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.workflow</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    <!-- Add Text Here -->
                </p><p>
                <!-- More details about what a user can do with this object will be OK -->
            </p>
            </field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem
                id="purchase_workflow_menu"
                name="Purchase Workflow"
                parent="purchase.menu_purchase_config"
                action="purchase_workflow_action_view"
        />

    </data>
</odoo>